# Những gì KHÔNG gửi vào Docker build context.
# "**/" để khớp ở mọi cấp thư mục, không chỉ thư mục gốc.

# Secrets
**/.env
**/.env.*
!.env.example

# Python cache và virtualenv
**/__pycache__
**/*.pyc
**/venv
**/.venv

# Git, IDE
.git
.vscode
.idea

# Không cần khi chạy agent
benchmark-observability/
*.md
check_production_ready.py
docker-compose.yml
railway.toml
render.yaml
