# Mẫu biến môi trường. Dùng: cp .env.example .env  (.env đã nằm trong .gitignore)
# KHÔNG ghi secret thật vào file này.

# Cổng agent lắng nghe (Railway/Render tự cấp)
PORT=8000
# development | staging | production
ENVIRONMENT=development

# Bắt buộc. Để trống thì mọi request /ask bị từ chối.
# Tạo key: openssl rand -hex 32
AGENT_API_KEY=

# Redis lưu trạng thái rate limit và chi phí
REDIS_URL=redis://localhost:6379/0

# Số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10
# Ngân sách LLM mỗi ngày (USD)
DAILY_BUDGET_USD=1.0
